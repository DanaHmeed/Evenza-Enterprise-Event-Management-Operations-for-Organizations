// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id // Clerk userId
  email     String   @unique
  name      String
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events    Event[]  @relation("UserEvents")
}

model Event {
  id          String @id @default(cuid())
  title       String
  description String
  category    String

  // Time
  startDate DateTime
  endDate   DateTime
  timezone  String

  // Location
  isOnline  Boolean
  venueName String?
  address   String?
  city      String?

  // Capacity
  capacity       Int
  seatsRemaining Int

  // Pricing
  eventType EventType
  price     Float?
  currency  String?

  status EventStatus @default(DRAFT)

  // Relations
  organizerId String
  organizer   User   @relation("UserEvents", fields: [organizerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  USER
  ORGANIZER
  ADMIN
}

enum EventType {
  FREE
  PAID
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}
